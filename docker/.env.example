# Copy to .env.
DECK_DOMAIN=deck.example.org
LETSENCRYPT_EMAIL=you@example.org
# 1: Let's Encrypt staging (no rate limits, untrusted certificate) while testing
LETSENCRYPT_STAGING=1
# Seconds to wait for the INWX DNS record before Let's Encrypt checks it
INWX_PROPAGATION_SECONDS=120
# Numeric id of the host group in udev/99-ulanzi-d200.rules: getent group usb-d200
D200_USB_GID=
